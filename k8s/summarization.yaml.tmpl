# Jobs are batch processing resources meant to run once or on a schedule.
apiVersion: batch/v1
kind: Job
metadata:
  name: overfitclub-speculative-decoding-summarization
spec:
  template:
    spec:
      imagePullSecrets:
        - name: ${image_pull_secret}
      securityContext:
        runAsUser: 0 # Run Docker image as user root.
      containers:
        - name: speculative-decoding-summarization
          image: ${eval_image}
          imagePullPolicy: Always
          # entrypoint.sh syncs the environment into the PVC, then runs these args.
          args:
            - python
            - evaluate.py
            - --compile
            - reduce-overhead
            - -d
            - ${draft_model_name}
            - -t
            - ${target_model_name}
            - -g
            - "5"
            - -k
            - summarization
            - --static-cache
            - --temperature
            - "0"
          env:
            - name: TORCH_CUDA
              value: "${torch_cuda}"
            - name: HF_HUB_DISABLE_XET # The xet downloader drops large transfers sometimes, plain HTTP is steadier.
              value: "1"
          volumeMounts:
            - name: ${pvc_name}
              mountPath: /cache # Persistent volume claim for the venv, uv cache and HF weights (see entrypoint.sh).
          resources:
            requests:
              cpu: "1"
              memory: "48Gi"
            limits:
              cpu: "4"
              memory: "64Gi"
              nvidia.com/gpu: "1"
      nodeSelector:
        gpu: ${gpu}
        ${gpu_product_selector}
      restartPolicy: Never

      volumes:
        - name: ${pvc_name}
          persistentVolumeClaim:
            claimName: ${pvc_name}
  backoffLimit: 2
