# Unconditional speculative decoding of a decoder-only target (e.g. Pythia-1B) from the start token, the counterpart of the
# paper's GPT-like lm1b experiment. The target and draft come from `config.json`, the rest has defaults in
# `scripts/generate_manifests.py`. `--set key=value` overrides any of them. Rendered with:
#   python3 scripts/generate_manifests.py --templates unconditional --set job_name=... --set gpu_product=...
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
spec:
  template:
    spec:
      imagePullSecrets:
        - name: ${image_pull_secret}
      securityContext:
        runAsUser: 0 # Run Docker image as user root.
      containers:
        - name: speculative-decoding-unconditional
          image: ${dockerhub_namespace}/overfitclub-speculative-decoding:latest
          imagePullPolicy: Always
          # entrypoint.sh syncs the environment into the PVC, then runs these args.
          # The values of draft_model_name, gamma and temperature can each list several, separated by spaces, which
          # makes a sweep over their combinations that loads the target model only once.
          args:
            - sh
            - -c
            - >-
              exec python evaluate.py --compile reduce-overhead --static-cache --dtype float32
              -d ${draft_model_name} -t ${target_model_name} -g ${gamma} -k unconditional --max-new-tokens ${max_new_tokens}
              --temperature ${temperature} --num-examples ${num_examples}
              --output /cache/results/${job_name}.json
          env:
            - name: TORCH_CUDA
              value: "${torch_cuda}"
            - name: HF_HUB_DISABLE_XET # The xet downloader drops large transfers sometimes, plain HTTP is steadier.
              value: "1"
          volumeMounts:
            - name: ${pvc_name}
              mountPath: /cache # Persistent volume claim for the venv, uv cache, HF weights and results (see entrypoint.sh).
          resources:
            requests:
              cpu: "1"
              memory: "48Gi"
            limits:
              cpu: "4"
              memory: "${memory_limit}"
              nvidia.com/gpu: "1"
      nodeSelector:
        gpu: ${gpu}
        ${gpu_product_selector}
      restartPolicy: Never

      volumes:
        - name: ${pvc_name}
          persistentVolumeClaim:
            claimName: ${pvc_name}
  backoffLimit: 0
