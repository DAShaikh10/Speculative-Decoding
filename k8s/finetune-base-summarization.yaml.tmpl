# Settings not set below are the recipe defaults of finetune.train.Config.
# The best checkpoint is written to /cache/finetune/base-summarization/best.
apiVersion: batch/v1
kind: Job
metadata:
  name: overfitclub-finetune-base-summarization
spec:
  template:
    spec:
      imagePullSecrets:
        - name: ${image_pull_secret}
      securityContext:
        runAsUser: 0 # Run Docker image as user root.
      containers:
        - name: finetune-base-summarization
          image: ${dockerhub_namespace}/overfitclub-speculative-decoding-finetune:latest
          # entrypoint.sh syncs the environment into the PVC, then runs these args.
          args:
            - python
            - -m
            - finetune.train
            - --set
            - model=google/t5-v1_1-base
            - task=summarization
            - output_dir=/cache/finetune/base-summarization
            - cache_dir=/cache/finetune/data
            - data_dir=/cache/finetune/tfds
            - strategy=none
            - micro_batch_tokens=8192
            - gradient_checkpointing=false
          env:
            - name: TORCH_CUDA
              value: "${torch_cuda}"
          volumeMounts:
            - name: ${pvc_name}
              mountPath: /cache # Persistent volume claim for the venv, uv cache, HF weights and the checkpoints.
          resources:
            requests:
              cpu: "4"
              memory: "48Gi"
            limits:
              cpu: "8"
              memory: "64Gi"
              nvidia.com/gpu: "1"
      nodeSelector:
        gpu: ${gpu}
        ${gpu_product_selector}
      restartPolicy: Never

      volumes:
        - name: ${pvc_name}
          persistentVolumeClaim:
            claimName: ${pvc_name}
  backoffLimit: 0
