# Batch-size experiment, translation: ${target_model_name} target, ${draft_model_name} draft, like translation.yaml (gamma 7, temperature 0).
# Run batched-smoke.yaml first. The same image notes apply.
apiVersion: batch/v1
kind: Job
metadata:
  name: overfitclub-batched-sd-translation
spec:
  template:
    spec:
      imagePullSecrets:
        - name: ${image_pull_secret}
      securityContext:
        runAsUser: 0 # Run Docker image as user root.
      containers:
        - name: batched-sd-translation
          image: ${dockerhub_namespace}/overfitclub-speculative-decoding:latest
          imagePullPolicy: Always
          # entrypoint.sh syncs the environment into the PVC, then runs these args.
          args:
            - python
            - -m
            - speculative_decoding.batched_evaluate
            - -d
            - ${draft_model_name}
            - -t
            - ${target_model_name}
            - -g
            - "7"
            - -k
            - translation
            - --temperature
            - "0"
            - --batch-sizes
            - "1"
            - "2"
            - "4"
            - "8"
            - "16"
            - "32"
            - --num-examples
            - "128" # A multiple of every batch size, so they all decode the same inputs.
            - --predict
            - --output
            - /cache/results/batched_translation_results_translation.json # Named after the target model, so the file can't mislabel it.
          env:
            - name: TORCH_CUDA
              value: "${torch_cuda}"
            - name: HF_HUB_DISABLE_XET # The xet downloader drops large transfers sometimes, plain HTTP is steadier.
              value: "1"
          volumeMounts:
            - name: ${pvc_name}
              mountPath: /cache # Persistent volume claim for the venv, uv cache and HF weights (see entrypoint.sh).
          resources:
            requests:
              cpu: "1"
              memory: "48Gi"
            limits:
              cpu: "4"
              memory: "64Gi"
              nvidia.com/gpu: "1"
      nodeSelector:
        gpu: ${gpu}
        ${gpu_product_selector}
      restartPolicy: Never

      volumes:
        - name: ${pvc_name}
          persistentVolumeClaim:
            claimName: ${pvc_name}
  backoffLimit: 2
