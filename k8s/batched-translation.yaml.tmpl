# Batch-size experiment, translation: ${target_model_name} target, ${draft_model_name} draft, like translation.yaml (gamma 7, temperature 0).
apiVersion: batch/v1
kind: Job
metadata:
  name: overfitclub-batched-sd-translation
spec:
  template:
    spec:
      imagePullSecrets:
        - name: ${image_pull_secret}
      securityContext:
        runAsUser: 0
      containers:
        - name: batched-sd-translation
          image: ${dockerhub_namespace}/overfitclub-speculative-decoding:latest
          imagePullPolicy: Always
          args:
            - python
            - -m
            - speculative_decoding.batched_evaluate
            - -d
            - ${draft_model_name}
            - -t
            - ${target_model_name}
            - -g
            - "7"
            - -k
            - translation
            - --temperature
            - "0"
            - --batch-sizes
            - "1"
            - "2"
            - "4"
            - "8"
            - "16"
            - "32"
            - --num-examples
            - "128"
            - --max-new-tokens
            - "512"
            - --predict
            - --compile
            - reduce-overhead
            - --fuse-draft
            - --repeats
            - "5"
            - --output
            - /cache/results/batched_translation_results_translation.json
          env:
            - name: TORCH_CUDA
              value: "${torch_cuda}"
            - name: HF_HUB_DISABLE_XET
              value: "1"
          volumeMounts:
            - name: ${pvc_name}
              mountPath: /cache
          resources:
            requests:
              cpu: "1"
              memory: "48Gi"
            limits:
              cpu: "4"
              memory: "64Gi"
              nvidia.com/gpu: "1"
      nodeSelector:
        gpu: ${gpu}
        ${gpu_product_selector}
      restartPolicy: Never

      volumes:
        - name: ${pvc_name}
          persistentVolumeClaim:
            claimName: ${pvc_name}
  backoffLimit: 2
