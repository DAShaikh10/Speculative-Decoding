# Fits the unigram and bigram draft models: counts the tokens of a corpus, tokenized for the target model. It needs no
# GPU. The target comes from `config.json`, the rest has defaults in `scripts/generate_manifests.py`. `--set key=value`
# overrides any of them. Rendered with:
#   python3 scripts/generate_manifests.py --templates ngram-fit --set job_name=... --set ngram_file=...
# Then evaluate with `draft_model_name=unigram:<ngram_file>` or `bigram:<ngram_file>` in the unconditional template.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
spec:
  template:
    spec:
      imagePullSecrets:
        - name: ${image_pull_secret}
      securityContext:
        runAsUser: 0 # Run Docker image as user root.
      containers:
        - name: speculative-decoding-ngram-fit
          image: ${dockerhub_namespace}/overfitclub-speculative-decoding:latest
          imagePullPolicy: Always
          # entrypoint.sh syncs the environment into the PVC, then runs these args.
          args:
            - python
            - fit_ngram.py
            - -t
            - ${target_model_name}
            - --num-tokens
            - "${ngram_tokens}"
            - --output
            - ${ngram_file}
          env:
            - name: TORCH_CUDA
              value: "${torch_cuda}"
            - name: HF_HUB_DISABLE_XET # The xet downloader drops large transfers sometimes, plain HTTP is steadier.
              value: "1"
          volumeMounts:
            - name: ${pvc_name}
              mountPath: /cache # Persistent volume claim for the venv, uv cache, HF cache and results (see entrypoint.sh).
          resources:
            requests:
              cpu: "2"
              memory: "16Gi"
            limits:
              cpu: "4"
              memory: "32Gi"
      restartPolicy: Never

      volumes:
        - name: ${pvc_name}
          persistentVolumeClaim:
            claimName: ${pvc_name}
  backoffLimit: 0
