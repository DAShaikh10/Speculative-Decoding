# Fine-tunes T5 v1.1 XXL on summarization on two GPUs with FSDP. Micro-batch and speed come from
# finetune.bench on 2 H200: 4096 tokens per GPU without gradient checkpointing, 8 micro-batches per step, about 6.4 s per
# step, worst-case peak 83.5 GB of 140 GB (8192 tokens runs out of memory). Settings not set below are
# the recipe defaults of finetune.train.Config. The best checkpoint is written to /cache/finetune/xxl-summarization/best.
apiVersion: batch/v1
kind: Job
metadata:
  name: overfitclub-finetune-xxl-summarization
spec:
  template:
    spec:
      imagePullSecrets:
        - name: ${image_pull_secret}
      securityContext:
        runAsUser: 0 # Run Docker image as user root.
      containers:
        - name: overfitclub-finetune-xxl-summarization
          image: ${dockerhub_namespace}/overfitclub-speculative-decoding-finetune:latest
          # entrypoint.sh syncs the environment into the PVC, then runs these args.
          args:
            - torchrun
            - --nproc-per-node
            - "2"
            - --master-addr
            - 127.0.0.1
            - --master-port
            - "29500"
            - -m
            - finetune.train
            - --set
            - model=google/t5-v1_1-xxl
            - task=summarization
            - output_dir=/cache/finetune/xxl-summarization
            - cache_dir=/cache/finetune/data
            - data_dir=/cache/finetune/tfds
            - strategy=fsdp
            - micro_batch_tokens=4096
            - gradient_checkpointing=false
            - max_steps=10000
            - eval_every=1000
          env:
            - name: TORCH_CUDA
              value: "${torch_cuda}"
          volumeMounts:
            - name: ${pvc_name}
              mountPath: /cache # Persistent volume claim for the venv, uv cache, HF weights and the checkpoints.
            - name: shm
              mountPath: /dev/shm # NCCL talks between the GPUs through shared memory, a pod only has 64MB by default.
          resources:
            requests:
              cpu: "16"
              memory: "192Gi"
            limits:
              cpu: "32"
              memory: "256Gi"
              nvidia.com/gpu: "2"
      nodeSelector:
        gpu: ${gpu}
        ${gpu_product_selector}
      restartPolicy: Never

      volumes:
        - name: shm
          emptyDir:
            medium: Memory
        - name: ${pvc_name}
          persistentVolumeClaim:
            claimName: ${pvc_name}
  backoffLimit: 0
